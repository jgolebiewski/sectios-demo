{
  "name": "sectios-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/packages/**"
  ],
  "dependencies": {
    "@fluentui/react": "^8.125.2",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@xstate/react": "^6.0.0",
    "axios": "^1.13.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-beforeunload": "^2.5.3",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^3.1.4",
    "react-hook-form": "^7.68.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.3.0",
    "styled-components": "^6.1.19",
    "uuid": "^13.0.0",
    "web-vitals": "^2.1.4",
    "xstate": "^5.24.0",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ignore-pattern api/*.js",
    "lint:fix": "eslint --fix .",
    "prepare": "husky install",
    "check:circular-deps": "madge --warning --circular --extensions ts,tsx src",
    "storybook": "storybook dev",
    "build-storybook": "storybook build",
    "api": "json-server --port 3004 --routes api/routes.json --watch api/mocks/db.json"
  },
  "jest": {
    "moduleNameMapper": {
      "axios": "axios/dist/node/axios.cjs"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "^10.1.4",
    "@storybook/preset-create-react-app": "^10.1.4",
    "@storybook/react": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.178",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-beforeunload": "^2.1.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.36",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.15",
    "ajv": "^8.17.0",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-named-exports-order": "^0.0.2",
    "eslint": "^9.39.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^15.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.1.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "flush-promises": "^1.0.2",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "madge": "^8.0.0",
    "msw": "^2.12.4",
    "prettier": "^3.7.4",
    "prop-types": "^15.8.1",
    "storybook": "^10.1.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  }
}
